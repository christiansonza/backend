# MongoDB connection string
#   Local:  mongodb://127.0.0.1:27017/tictactoe
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tictactoe?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/tictactoe

# Port the API listens on
PORT=4000

# Allowed frontend origins, comma separated. Leave empty to allow all.
CORS_ORIGIN=http://localhost:3000
